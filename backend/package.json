{
  "name": "dairy-management-backend",
  "version": "1.0.0",
  "description": "Dairy Farm Management System - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "npx prisma generate && node dist/server.js",
    "seed": "tsx prisma/seed.ts",
