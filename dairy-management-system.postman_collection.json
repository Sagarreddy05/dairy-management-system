{
  "info": {
    "name": "Dairy Management System",
    "description": "FarmFresh Dairy Farm Management System API collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@farmfresh.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Farmers",
      "item": [
        {
          "name": "List Farmers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/farmers?page=1&limit=10&search="
          }
        },
        {
          "name": "Create Farmer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmerName\": \"New Farmer\",\n  \"mobileNumber\": \"9999900001\",\n  \"village\": \"Anand\",\n  \"address\": \"Farm Road\",\n  \"cattleCount\": 5,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/farmers"
          }
        },
        {
          "name": "Get Farmer",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/farmers/:id"
          }
        },
        {
          "name": "Update Farmer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmerName\": \"Updated Farmer\",\n  \"mobileNumber\": \"9999900001\",\n  \"village\": \"Anand\",\n  \"address\": \"Farm Road\",\n  \"cattleCount\": 6,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/farmers/:id"
          }
        },
        {
          "name": "Delete Farmer",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/farmers/:id"
          }
        }
      ]
    },
